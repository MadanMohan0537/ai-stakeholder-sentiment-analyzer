OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONTEXT=16384
# DeepSeek is optional and may charge. Off by default.
# You can enter a session-only key in the app under API settings instead.
# ALLOW_PAID_API is for scripts; browser sessions require their own opt-in.
# Other OpenAI-compatible APIs (optional; set your own model and key):
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_JSON_MODE=true
ALLOW_PAID_API=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
PORT=7864
# APP_DATA_DIR=./data
GRADIO_ANALYTICS_ENABLED=False
